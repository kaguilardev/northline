<section class="cta-band">
  <div class="container">
    <div class="label" style="color:var(--gold)">Free, no-pressure estimates</div>
    <h2 style="margin-top:12px"><%= typeof ctaTitle !== 'undefined' ? ctaTitle : 'Let’s plan your new patio.' %></h2>
    <p>Tell us about your project and send a few photos of the space. We’ll follow up to schedule a visit and send you a written proposal.</p>
    <div class="row">
      <a class="btn btn-gold btn-lg" href="/estimate">Get a Free Estimate <%- icon('arrow') %></a>
      <% if (contact.phone) { %><a class="btn btn-light btn-lg" href="tel:<%= contact.phone.replace(/[^\d+]/g,'') %>"><%- icon('phone') %> <%= contact.phone %></a><% } %>
    </div>
  </div>
</section>
