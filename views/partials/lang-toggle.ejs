<% if (typeof showLangToggle !== 'undefined' && showLangToggle) { %><span class="lang" role="group" aria-label="Language / Idioma" translate="no"><% Object.keys(langs).forEach(code => { %><a href="<%= langUrl(code) %>" class="<%= lang === code ? 'on' : '' %>" lang="<%= code %>" hreflang="<%= code %>" aria-current="<%= lang === code ? 'true' : 'false' %>" title="<%= langs[code] %>"><%= code.toUpperCase() %></a><% }) %></span><% } %>
