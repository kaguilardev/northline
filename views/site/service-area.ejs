<%- include('../partials/site-head', { title: 'Service Area' }) %>
<section class="page-hero">
  <div class="container">
    <div class="label">Service area</div>
    <h1>Serving the Triangle.</h1>
    <p class="lede">We work with homeowners in Durham, Raleigh, Cary, Chapel Hill and the surrounding North Carolina communities.</p>
  </div>
  <div class="pines" aria-hidden="true"></div>
</section>
<section class="section">
  <div class="container">
    <div class="grid g5">
      <% areas.forEach(a => { %>
      <div class="card svc reveal" style="align-items:center;text-align:center">
        <span class="medal"><%- icon('pin') %></span>
        <h3><%= a %></h3>
        <p><%= a === 'Surrounding Areas' ? 'Nearby? Ask us — we likely cover you.' : 'North Carolina' %></p>
      </div>
      <% }) %>
    </div>
    <p class="center muted" style="margin-top:32px">Not sure if you’re in our area? <a href="/estimate">Send us your address</a> and we’ll let you know.</p>
  </div>
</section>
<%- include('../partials/cta') %>
<%- include('../partials/site-foot') %>
