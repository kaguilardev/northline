<%- include('../partials/site-head', { title: 'About Northline', description: 'Northline Home & Outdoor builds residential concrete patios, walkways and small slabs in Durham, Raleigh, Cary and Chapel Hill.' }) %>
<section class="page-hero">
  <div class="container">
    <div class="label">About Northline</div>
    <h1>Residential concrete, one project at a time.</h1>
    <p class="lede">Northline Home &amp; Outdoor builds concrete patios, patio extensions, walkways and small slabs for homeowners around the Triangle.</p>
  </div>
  <div class="pines" aria-hidden="true"></div>
</section>
<section class="section">
  <div class="container split">
    <div class="reveal">
      <div class="label">Our approach</div>
      <h2 style="margin:12px 0 18px">A narrow focus, done well.</h2>
      <p>We focus on residential concrete, so every project gets our full attention, from the first photos you send to the final cleanup.</p>
      <p>Before any work begins, you’ll get a written proposal that shows what we’ll build, how we’ll prepare the ground and what it will cost.</p>
    </div>
    <div class="card reveal">
      <h3 style="margin-bottom:16px">What you can expect</h3>
      <ul class="checks">
        <li><%- icon('check') %><span>A visit to your home to measure and check the ground</span></li>
        <li><%- icon('check') %><span>A clear written proposal before any work begins</span></li>
        <li><%- icon('check') %><span>Confirmed appointments and clear communication</span></li>
        <li><%- icon('check') %><span>Careful work, and we clean up before we leave</span></li>
      </ul>
    </div>
  </div>
</section>
