<%- include('../partials/site-head', { title: 'Our Work', description: 'Concrete patios, walkways and slabs built by Northline in Durham and the Triangle: before, preparation and the finished result.' }) %>
<section class="page-hero">
  <div class="container">
    <div class="label">Our work</div>
    <h1>Before, preparation &amp; result.</h1>
    <p class="lede">Real Northline concrete projects from around the Triangle.</p>
  </div>
  <div class="pines" aria-hidden="true"></div>
</section>
<section class="section">
  <div class="container">
    <% if (!projects.length) { %>
      <div class="empty reveal">
        <span class="medal"><%- icon('camera') %></span>
        <h3>Project photos are on the way.</h3>
        <p class="muted" style="max-width:460px;margin:10px auto 22px">We’re adding photos from our concrete projects. Want yours to be next?</p>
        <a class="btn btn-gold" href="/estimate">Get a Free Estimate</a>
      </div>
    <% } else { %>
    <div class="grid g2">
      <% projects.forEach(p => { const shots = [['Before', p.before], ['Preparation', p.prep], ['Result', p.after]].filter(s => s[1]); %>
      <article class="card ba reveal">
        <div class="pair <%= shots.length === 3 ? 'three' : '' %>">
          <% shots.forEach(([cap, id]) => { %><figure><img src="/photo/<%= id %>" alt="<%= cap %>" loading="lazy"><figcaption><%= cap %></figcaption></figure><% }) %>
        </div>
        <div class="info">
          <h3><%= p.package || p.service || 'Northline project' %></h3>
          <% if (p.customer_review) { %><p style="margin:12px 0 0;font-style:italic;font-size:15px">“<%= p.customer_review %>”</p><% } %>
        </div>
      </article>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/cta') %>
<%- include('../partials/site-foot') %>
