<%- include('../partials/site-head', { title: '' }) %>
<section class="hero">
  <div class="container">
    <div>
      <div class="label">Residential Home &amp; Outdoor Services</div>
      <h1 style="margin-top:16px">Professional quality<br>at a <em>fair price.</em></h1>
      <p class="lede">Painting, landscaping, pressure washing, remodeling, decks &amp; fences — one organized, on-time team for the work around your home in Durham, Raleigh, Cary and Chapel Hill.</p>
      <div class="cta">
        <a class="btn btn-gold btn-lg" href="/estimate">Get a Free Estimate <%- icon('arrow') %></a>
        <a class="btn btn-ghost btn-lg" href="/lawn-care">See Our Pricing</a>
      </div>
      <div class="trust">
        <span><%- icon('shield') %> Quality Work</span>
        <span><%- icon('sprout') %> Premium Materials</span>
        <span><%- icon('users') %> Residential Experts</span>
      </div>
    </div>
    <div class="price-stack" aria-label="Starting prices">
      <a class="price-card" href="/lawn-care"><span class="badge"><%- icon('leaf') %></span><span><span class="t">Basic Lawn Care</span><br><span class="s">Mow • Trim • Edge • Blow</span></span><span class="p"><small>From</small>$49</span></a>
      <a class="price-card" href="/lawn-care#packages"><span class="badge"><%- icon('house') %></span><span><span class="t">Curb Appeal</span><br><span class="s">Lawn care + pressure washing</span></span><span class="p"><small>From</small>$129</span></a>
      <a class="price-card" href="/painting"><span class="badge"><%- icon('roller') %></span><span><span class="t">Room Refresh</span><br><span class="s">Prep + two coats, one room</span></span><span class="p"><small>From</small>$400</span></a>
    </div>
  </div>
  <div class="pines" aria-hidden="true"></div>
</section>

<div class="band"><div class="container"><span>Clean</span><span class="dot">•</span><span>Reliable</span><span class="dot">•</span><span>Professional</span></div></div>

<section class="section">
  <div class="container">
    <div class="section-head center reveal">
      <div class="label rule">What we do</div>
      <h2>One call for the work around your house.</h2>
      <p class="lede">No more juggling a different contractor for every job. With Northline, one trusted team takes care of the inside and the outside.</p>
    </div>
    <div class="grid g5 balanced">
      <% services.forEach(s => { %>
      <a class="card svc reveal" href="<%= s.href %>">
        <span class="medal"><%- icon(s.icon) %></span>
        <h3><%= s.short %></h3>
        <p><%= s.blurb %></p>
        <span class="more">Learn more <%- icon('arrow') %></span>
      </a>
      <% }) %>
    </div>
    <p class="center reveal biz-line"><%- icon('building') %> Own or manage a business property? <a href="/commercial">See our commercial services →</a></p>
  </div>
</section>

<section class="section alt">
  <div class="container split">
    <div class="reveal">
      <div class="label">The Northline standard</div>
      <h2 style="margin:12px 0 22px">The little things, done right every time.</h2>
      <blockquote class="quote-block">Our promise is simple: treat every home like it’s our own, and leave it better than we found it.</blockquote>
    </div>
    <ul class="checks reveal">
      <li><%- icon('check') %><span><strong>Uniformed crews</strong> — you’ll always know who’s on your property.</span></li>
      <li><%- icon('check') %><span><strong>Clear communication</strong> and confirmed appointments.</span></li>
      <li><%- icon('check') %><span><strong>Respect for your home</strong> — we work carefully and clean up before we leave.</span></li>
      <li><%- icon('check') %><span><strong>Professional written estimates</strong> with no surprises.</span></li>
      <li><%- icon('check') %><span><strong>We do what we promise</strong> — on time, every time.</span></li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head center reveal"><div class="label rule">How it works</div><h2>Getting started is easy.</h2></div>
    <div class="grid g3 steps">
      <div class="step reveal"><h3>Tell us what you need</h3><p>Fill out a quick form and add a few photos of the area. Photos let us quote most jobs without a site visit.</p></div>
      <div class="step reveal"><h3>Get a clear estimate</h3><p>We send a professional, itemized estimate you can review and accept online.</p></div>
      <div class="step reveal"><h3>We show up and deliver</h3><p>A uniformed crew arrives on schedule, does the work right and leaves your property clean.</p></div>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/site-foot') %>
