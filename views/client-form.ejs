<%- include('partials/head', { title: customer.id ? customer.name : 'New client' }) %>
<% const d = customer.next_visit ? new Date(customer.next_visit).toISOString().slice(0,10) : ''; %>
<div class="pagehead"><h1><%= customer.id ? 'Edit client' : 'New client' %></h1><a href="/admin/clients" class="muted">← All clients</a></div>
<form class="card form" method="post" action="/admin/clients<%= customer.id ? '/' + customer.id : '' %>">
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <div class="cols">
    <label>Name * <input name="name" value="<%= customer.name || '' %>" required></label>
    <label>Service <input name="service" value="<%= customer.service || '' %>" placeholder="e.g. Weekly mowing"></label>
    <label>Email <input type="email" name="email" value="<%= customer.email || '' %>"></label>
    <label>Phone <input name="phone" value="<%= customer.phone || '' %>"></label>
    <label class="span2">Address <input name="address" value="<%= customer.address || '' %>"></label>
    <label>Status
      <select name="status">
        <% const opts = ['scheduled','in_progress','completed','on_hold']; if (['lead','quoted'].includes(customer.status)) opts.unshift(customer.status); %>
        <% opts.forEach(s => { %>
          <option value="<%= s %>" <%= (customer.status || 'scheduled') === s ? 'selected' : '' %>><%= s === 'lead' || s === 'quoted' ? s + ' (prospect)' : s.replace('_',' ') %></option>
        <% }) %>
      </select></label>
    <label>Next visit <input type="date" name="next_visit" value="<%= d %>"></label>
    <label class="span2">Notes <textarea name="notes" rows="4"><%= customer.notes || '' %></textarea></label>
    <label class="check span2"><input type="checkbox" name="email_opt_in" <%= customer.email_opt_in === false ? '' : 'checked' %>> Send this client marketing emails</label>
  </div>
  <div class="row">
    <button class="btn">Save client</button>
  </div>
</form>
<% if (customer.id && typeof quotes !== 'undefined') { %>
<div class="grid2" style="margin-top:18px">
  <section class="card">
    <div class="pagehead" style="margin-bottom:8px"><h2 style="margin:0">Quotes</h2><a class="btn small gold" href="/admin/quotes/new?client=<%= customer.id %>">+ Quote</a></div>
    <% if (!quotes.length) { %><p class="muted">No quotes yet.</p><% } %>
    <ul class="list"><% quotes.forEach(q => { %><li><a href="/admin/quotes/<%= q.id %>"><strong><span translate="no"><%= q.number %></span></strong></a><span class="muted"><%= q.title || '' %> · <%= money(q.total) %></span><span class="date"><span class="pill <%= q.status %>"><%= q.status %></span></span></li><% }) %></ul>
  </section>
  <section class="card">
    <div class="pagehead" style="margin-bottom:8px"><h2 style="margin:0">Jobs</h2><a class="btn small" href="/admin/jobs/new?client=<%= customer.id %>">+ Job</a></div>
    <% if (!jobs.length) { %><p class="muted">No jobs yet.</p><% } %>
    <ul class="list"><% jobs.forEach(j => { %><li><a href="/admin/jobs/<%= j.id %>"><strong><%= j.package || j.service || 'Job #' + j.id %></strong></a><span class="muted"><%= j.job_date ? fmtDate(j.job_date) : 'No date' %> · <%= j.quoted_price != null ? money(j.quoted_price) : '' %></span><span class="date"><span class="pill <%= j.status %>"><%= j.status.replace('_',' ') %></span></span></li><% }) %></ul>
  </section>
</div>
<% } %>
<% if (customer.id) { %>
<form method="post" action="/admin/clients/<%= customer.id %>/delete" onsubmit="return confirm('Delete this client?')">
  <button class="link danger">Delete client</button>
</form>
<% } %>
<%- include('partials/foot') %>
