<%- include('partials/head', { title: 'Sign in' }) %>
<div class="auth">
  <form method="post" action="/login" class="card">
    <img src="/img/logo.png" alt="Northline Home & Outdoor" style="width:170px;margin:0 auto 18px;display:block">
    <h1>Team sign in</h1>
    <% if (error) { %><p class="alert"><%= error %></p><% } %>
    <label>Email <input type="email" name="email" value="<%= email %>" required autofocus autocomplete="username"></label>
    <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
    <div class="login-row">
      <label class="check"><input type="checkbox" name="remember" checked> Remember me</label>
      <a class="small" href="/forgot">Forgot password?</a>
    </div>
    <button class="btn full">Sign in</button>
    <a class="muted small" href="/">← Back to site</a>
  </form>
</div>
<%- include('partials/foot') %>
