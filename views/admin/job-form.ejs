<%- include('../partials/head') %>
<% const d = (v) => v ? new Date(v).toISOString().slice(0,10) : ''; const profit = (job.quoted_price != null && job.actual_cost != null) ? job.quoted_price - job.actual_cost : null; %>
<div class="pagehead">
  <div><a href="/admin/jobs" class="muted small">← All jobs</a><h1 style="margin-top:6px"><%= job.id ? 'Job #' + job.id : 'New job' %></h1></div>
  <% if (job.quote_id) { %><a class="btn ghost" href="/admin/quotes/<%= job.quote_id %>">View quote</a><% } %>
</div>
<form method="post" action="/admin/jobs<%= job.id ? '/' + job.id : '' %>" enctype="multipart/form-data" class="grid2 wide-left" style="align-items:start">
  <div>
    <section class="card form">
      <input type="hidden" name="quote_id" value="<%= job.quote_id || '' %>">
      <div class="cols">
        <label class="span2">Customer
          <select name="client_id"><option value="">—</option><% clients.forEach(c => { %><option value="<%= c.id %>" <%= String(job.client_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label>
        <label>Service
          <select name="service"><option value="">—</option><% SERVICE_TYPES.forEach(s => { %><option <%= job.service === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
        <label>Package <input name="package" value="<%= job.package || '' %>" placeholder="e.g. Full Refresh — Medium"></label>
        <label>Job date <input type="date" name="job_date" value="<%= d(job.job_date) %>"></label>
        <label>Employees assigned <input name="employees" value="<%= job.employees || '' %>" placeholder="Names"></label>
        <label>Job status <select name="status"><% JOB_STATUSES.forEach(s => { %><option value="<%= s %>" <%= job.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %></select></label>
        <label>Payment status <select name="payment_status"><% PAY_STATUSES.forEach(s => { %><option value="<%= s %>" <%= job.payment_status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
      </div>
    </section>
    <section class="card form" style="margin-top:18px">
      <h2>Money</h2>
      <div class="cols">
        <label>Quoted price ($) <input type="number" step="0.01" name="quoted_price" value="<%= job.quoted_price ?? '' %>" data-calc></label>
        <label>Materials ($) <input type="number" step="0.01" name="materials_cost" value="<%= job.materials_cost ?? '' %>"></label>
        <label>Labor hours <input type="number" step="0.25" name="labor_hours" value="<%= job.labor_hours ?? '' %>"></label>
        <label>Actual cost ($) <small class="muted">materials + labor + other</small><input type="number" step="0.01" name="actual_cost" value="<%= job.actual_cost ?? '' %>" data-calc></label>
      </div>
      <div class="total-row" style="padding:4px 0 0"><span>Gross profit</span><strong id="profit"><%= profit != null ? money(profit) : '—' %></strong></div>
    </section>
    <section class="card form" style="margin-top:18px">
      <h2>Photos</h2>
      <div class="cols">
        <label>Add before photos <input type="file" name="before" accept="image/*" multiple></label>
        <label>Add after photos <input type="file" name="after" accept="image/*" multiple></label>
      </div>
      <div class="photos">
        <% photos.forEach(p => { %><div class="photo-cell"><a href="/photo/<%= p.id %>" target="_blank"><img src="/photo/<%= p.id %>" alt="" loading="lazy"><span class="tag"><%= p.kind %></span></a><button class="del" type="submit" form="delphoto<%= p.id %>" title="Delete photo" onclick="return confirm('Delete this photo?')">×</button></div><% }) %>
      </div>
      <label class="check" style="margin-top:14px"><input type="checkbox" name="show_in_gallery" <%= job.show_in_gallery ? 'checked' : '' %>> Show this job’s before/after in the public gallery</label>
    </section>
    <section class="card form" style="margin-top:18px">
      <h2>Customer review</h2>
      <div class="cols">
        <label>Rating <select name="review_rating"><option value="">—</option><% [5,4,3,2,1].forEach(n => { %><option value="<%= n %>" <%= job.review_rating == n ? 'selected' : '' %>><%= '★'.repeat(n) %></option><% }) %></select></label>
        <label class="span2">Review <textarea name="customer_review" rows="3"><%= job.customer_review || '' %></textarea></label>
        <label class="span2">Internal notes <textarea name="notes" rows="3"><%= job.notes || '' %></textarea></label>
      </div>
      <div class="row"><button class="btn gold">Save job</button></div>
    </section>
  </div>
  <aside class="card sticky">
    <h2>Summary</h2>
    <dl class="facts">
      <dt>Quoted</dt><dd class="money"><%= job.quoted_price != null ? money(job.quoted_price) : '—' %></dd>
      <dt>Actual cost</dt><dd class="money"><%= job.actual_cost != null ? money(job.actual_cost) : '—' %></dd>
      <dt>Profit</dt><dd class="money <%= profit != null ? (profit < 0 ? 'neg' : 'pos') : '' %>"><%= profit != null ? money(profit) : '—' %></dd>
      <dt>Margin</dt><dd><%= profit != null && job.quoted_price > 0 ? Math.round(profit / job.quoted_price * 100) + '%' : '—' %></dd>
      <dt>Per hour</dt><dd class="money"><%= profit != null && job.labor_hours > 0 ? money(Math.round(profit / job.labor_hours)) + '/hr' : '—' %></dd>
    </dl>
  </aside>
</form>
<% if (job.id) { %>
  <% photos.forEach(p => { %><form id="delphoto<%= p.id %>" method="post" action="/admin/photos/<%= p.id %>/delete"></form><% }) %>
  <form method="post" action="/admin/jobs/<%= job.id %>/delete" onsubmit="return confirm('Delete this job?')" style="margin-top:14px"><button class="link danger small">Delete job</button></form>
<% } %>
<script>
  (function () {
    var q = document.querySelector('[name=quoted_price]'), c = document.querySelector('[name=actual_cost]'), out = document.getElementById('profit');
    function upd() { if (q.value === '' || c.value === '') { out.textContent = '—'; return; }
      var p = Number(q.value) - Number(c.value); out.textContent = (p < 0 ? '-$' : '$') + Math.abs(p).toLocaleString('en-US', { maximumFractionDigits: 2 }); }
    q.oninput = c.oninput = upd;
  })();
</script>
<%- include('../partials/foot') %>
