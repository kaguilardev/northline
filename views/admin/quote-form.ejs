<%- include('../partials/head') %>
<% const isEdit = !!quote.id; const json = (v) => JSON.stringify(v).replace(/</g, '\\u003c'); %>
<div class="pagehead">
  <div><a href="<%= isEdit ? '/admin/quotes/' + quote.id : '/admin/quotes' %>" class="muted small">← Back</a><h1 style="margin-top:6px"><%= isEdit ? 'Edit ' + quote.number : 'New quote' %></h1></div>
</div>
<% if (fromRequest) { %>
  <p class="notice">Quoting request from <strong><span translate="no"><%= fromRequest.name %></span></strong> — <%= fromRequest.service %>. <a href="/admin/requests/<%= fromRequest.id %>" target="_blank">View photos ↗</a>
  <% if (fromRequest.description) { %><br><span class="small"><%= fromRequest.description %></span><% } %></p>
<% } %>
<form method="post" action="/admin/quotes<%= isEdit ? '/' + quote.id : '' %>" id="qform" class="grid2 wide-left" style="align-items:start">
  <div>
    <section class="card form">
      <input type="hidden" name="request_id" value="<%= quote.request_id || '' %>">
      <div class="cols">
        <label class="span2">Customer
          <select name="client_id" id="clientSel">
            <option value="">+ New customer…</option>
            <% clients.forEach(c => { %><option value="<%= c.id %>" <%= String(quote.client_id) === String(c.id) ? 'selected' : '' %>><span translate="no"><%= c.name %></span><span translate="no"><%= c.email ? ' — ' + c.email : '' %></span></option><% }) %>
          </select>
        </label>
      </div>
      <fieldset id="newClient">
        <legend>New customer</legend>
        <div class="cols">
          <label>Name <input name="new_name" value="<%= fromRequest ? fromRequest.name : '' %>"></label>
          <label>Email <input type="email" name="new_email" value="<%= fromRequest ? fromRequest.email || '' : '' %>"></label>
          <label>Phone <input name="new_phone" value="<%= fromRequest ? fromRequest.phone || '' : '' %>"></label>
          <label>Address <input name="new_address" value="<%= fromRequest ? fromRequest.address || '' : '' %>"></label>
        </div>
      </fieldset>
      <div class="cols">
        <label>Project title <input name="title" value="<%= quote.title || '' %>" placeholder="e.g. Backyard patio — 12 × 16 ft"></label>
        <label>Valid until <input type="date" name="valid_until" value="<%= quote.valid_until || '' %>"></label>
      </div>
    </section>

    <section class="card flush" style="margin-top:18px">
      <table class="items">
        <thead><tr><th>Item</th><th>Details</th><th style="text-align:right">Amount</th><th></th></tr></thead>
        <tbody id="itemRows"></tbody>
      </table>
      <div style="padding:12px 16px"><button type="button" class="btn ghost small" id="addBlank">+ Custom line</button> <span class="muted small">or add items from the price book →</span></div>
      <div class="total-row"><span>Total</span><strong id="total">$0</strong></div>
      <p class="notice" id="minWarn" style="margin:0 16px 14px" hidden></p>
    </section>

    <section class="card form" style="margin-top:18px">
      <label>Notes for the customer <textarea name="notes" rows="4" placeholder="Thickness, finish, schedule, payment terms…"><%= quote.notes || '' %></textarea></label>
      <% if (quote.paint_note) { %><label class="check"><input type="checkbox" name="paint_note" checked> Show “Paint not included” (from an older painting quote)</label><% } %>
      <input type="hidden" name="items" id="itemsField">
      <div class="row"><button class="btn gold">Save quote</button><a class="btn ghost" href="/admin/quotes">Cancel</a></div>
    </section>
  </div>

  <aside class="card book sticky" id="book" data-type="<%= fromRequest ? fromRequest.service : '' %>">
    <h2 style="margin-bottom:12px">Price book</h2>
    <h3>Concrete</h3>
    <label class="mini">Project type <select id="cType"></select></label>
    <div class="row2">
      <label class="mini">Length (ft) <input id="cLen" type="number" min="0" step="0.5" inputmode="decimal"></label>
      <label class="mini">Width (ft) <input id="cWid" type="number" min="0" step="0.5" inputmode="decimal"></label>
    </div>
    <p class="muted small" id="cCalc" style="margin:2px 0 10px">Enter the length and width.</p>
    <button type="button" class="btn full" id="addConcrete" disabled>Enter length and width</button>
    <% if (fromRequest && fromRequest.measurements) { %><p class="muted small" style="margin:8px 0 0">Customer’s size: <strong><%= fromRequest.measurements %></strong></p><% } %>

    <h3>Extras</h3>
    <p class="muted small" style="margin:-4px 0 6px">Uses the area above. Change it if the extra covers a different area.</p>
    <label class="mini">Area (sq ft) <input id="xArea" type="number" min="0" step="1" inputmode="decimal"></label>
    <div id="extraList"></div>
    <p class="muted small" style="margin:10px 0 0"><a href="/admin/prices">Change rates on the Prices page</a></p>
  </aside>
</form>

<script type="application/json" id="pricebook"><%- json(book) %></script>
<script type="application/json" id="initialItems"><%- json(quote.items || []) %></script>
<script src="/js/quote-builder.js"></script>
<%- include('../partials/foot') %>
