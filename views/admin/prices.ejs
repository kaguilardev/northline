<%- include('../partials/head') %>
<% const f = (name, v, label) => canEdit
     ? `<input class="price-in" type="number" min="0" step="0.01" name="${name}" value="${v ?? ''}" placeholder="—" aria-label="${label}">`
     : `<span class="price-ro">${v == null ? '—' : money(v)}</span>`; %>
<div class="pagehead">
  <div><h1>Prices</h1>
    <p class="muted small" style="margin:6px 0 0"><%= canEdit ? 'Change a rate and save — the quote builder uses the new numbers right away. Leave a rate empty to price that item by hand.' : 'Your current price list. Only an owner can change prices.' %>
    <% if (changed) { %> Last changed <%= fmtDate(changed.updated_at) %><%= changed.name ? ' by ' + changed.name.split(' ')[0] : '' %>.<% } %></p></div>
</div>
<% if (flash) { %><p class="success"><%= flash %></p><% } %>
<form method="post" action="/admin/prices" id="pricesForm">
  <section class="card flush">
    <div style="padding:18px 20px 4px"><h2 style="margin:0">Concrete work</h2><p class="muted small">Installed price per square foot for a standard 4" broom-finish job. The quote builder multiplies it by length × width.</p></div>
    <table class="price-grid">
      <thead><tr><th>Project type</th><th>Per sq ft</th><th>Raleigh–Durham market</th></tr></thead>
      <tbody><% p.CONCRETE_RATES.forEach(r => { %><tr><td><strong><%= r.name %></strong></td><td><%- f(`rate.${r.key}`, r.rate, r.name + ' rate per square foot') %></td><td class="muted small"><%= r.market %></td></tr><% }) %></tbody>
    </table>
    <div style="padding:18px 20px 4px"><h2 style="margin:0">Extras</h2><p class="muted small">Added on top of the concrete, also per square foot.</p></div>
    <table class="price-grid">
      <thead><tr><th>Extra</th><th>Per sq ft</th><th>Raleigh–Durham market</th></tr></thead>
      <tbody><% p.CONCRETE_EXTRAS.forEach(x => { %><tr><td><strong><%= x.name %></strong><div class="muted small"><%= x.desc %></div></td><td><%- f(`extra.${x.key}`, x.rate, x.name + ' rate per square foot') %></td><td class="muted small"><%= x.market %></td></tr><% }) %></tbody>
    </table>
    <div style="padding:18px 20px 4px"><h2 style="margin:0">Minimum job</h2><p class="muted small">The quote builder warns you when a quote comes in below this.</p></div>
    <table class="price-grid">
      <thead><tr><th></th><th>Amount</th><th>Raleigh–Durham market</th></tr></thead>
      <tbody><tr><td><strong>Minimum job charge</strong></td><td><%- f('minimum', p.MINIMUM_JOB.amount, 'Minimum job charge') %></td><td class="muted small"><%= p.MINIMUM_JOB.market %></td></tr></tbody>
    </table>
    <p class="muted small" style="padding:4px 20px 18px;margin:0">Starting rates were set 5% below the middle of the market range, from Angi, NCDOT-based and local cost guides (October 2026). Check them against your own material and labor costs.</p>
  </section>

  <% if (canEdit) { %>
  <div class="savebar"><span class="muted small" id="dirty">No changes yet.</span><button class="btn gold">Save prices</button></div>
  <% } %>
</form>
<% if (canEdit) { %>
<form method="post" action="/admin/prices/reset" onsubmit="return confirm('Put every rate back to the starting price list?')" style="margin-top:16px"><button class="link danger small">Reset to the starting price list</button></form>
<% } %>
<script>
  (function () {
    var form = document.getElementById('pricesForm'), dirty = document.getElementById('dirty'), changed = false;
    if (dirty) form.addEventListener('input', function (e) { e.target.classList.add('changed'); changed = true; dirty.textContent = 'You have unsaved changes.'; });
    window.addEventListener('beforeunload', function (e) { if (changed) { e.preventDefault(); e.returnValue = ''; } });
    form.addEventListener('submit', function () { changed = false; });
  })();
</script>
<%- include('../partials/foot') %>
