<%- include('../partials/head') %>
<div class="pagehead"><h1>Estimate requests</h1><a class="btn ghost" href="/estimate" target="_blank">Open public form ↗</a></div>
<% const qs = (o) => { const p = new URLSearchParams(); const s = o.status ?? tab, k = o.kind ?? kind; if (s !== 'active') p.set('status', s); if (k) p.set('kind', k); const str = p.toString(); return '/admin/requests' + (str ? '?' + str : ''); }; %>
<nav class="tabs" aria-label="Request stages">
  <% tabs.forEach(t => { %><a href="<%= qs({ status: t.key }) %>" class="<%= tab === t.key ? 'on' : '' %>"><%= t.label %> <span class="n"><%= t.n %></span></a><% }) %>
</nav>
<div class="seg" role="group" aria-label="Customer type">
  <a href="<%= qs({ kind: '' }) %>" class="<%= !kind ? 'on' : '' %>">Everyone</a>
  <a href="<%= qs({ kind: 'residential' }) %>" class="<%= kind === 'residential' ? 'on' : '' %>">Homeowners</a>
  <a href="<%= qs({ kind: 'commercial' }) %>" class="<%= kind === 'commercial' ? 'on' : '' %>">Commercial<% if (commercialCount) { %> <span class="n"><%= commercialCount %></span><% } %></a>
</div>
<p class="muted small" style="margin:-6px 0 14px">
  <% if (tab === 'archived') { %>Accepted and lost requests. Accepted ones are now customers in Clients.<% } else { %>Change the stage right from the list. When a customer accepts their quote, the request moves to Archived automatically.<% } %>
</p>
<div class="card flush">
  <table>
    <thead><tr><th>Received</th><th>Name</th><th>Service</th><th>Address</th><th>Photos</th><th>Stage</th></tr></thead>
    <tbody>
    <% if (!requests.length) { %><tr><td colspan="6" class="muted center"><%= tab === 'active' ? 'No open requests. They’ll appear here when customers use the estimate form.' : 'Nothing here right now.' %></td></tr><% } %>
    <% requests.forEach(r => { %>
      <tr onclick="location='/admin/requests/<%= r.id %>'" class="<%= r.viewed_at ? '' : 'unread' %>">
        <td class="small"><% if (!r.viewed_at) { %><span class="dot" title="Not opened yet"></span><% } %><%= fmtDate(r.created_at) %></td>
        <td><% if (r.kind === 'commercial') { %><span class="pill commercial">Commercial</span> <strong><%= r.company %></strong><div class="small"><%= r.name %></div><% } else { %><strong><%= r.name %></strong><% } %><div class="muted small"><%= r.phone %><% if (r.last_message_at) { %> · ✉ emailed <%= fmtDate(r.last_message_at) %><% } %></div></td>
        <td><%= r.service %></td>
        <td class="small"><%= r.address %></td>
        <td><%= r.photo_count || '—' %></td>
        <td onclick="event.stopPropagation()">
          <form method="post" action="/admin/requests/<%= r.id %>/status">
            <input type="hidden" name="back" value="<%= back %>">
            <select name="status" class="stage-select <%= r.status %>" onchange="this.form.submit()" aria-label="Stage for <%= r.name %>">
              <% stages.forEach(st => { %><option value="<%= st.key %>" <%= r.status === st.key ? 'selected' : '' %>><%= st.label %></option><% }) %>
            </select>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/foot') %>
