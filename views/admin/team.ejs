<%- include('../partials/head') %>
<div class="pagehead"><div><h1>Team</h1><p class="muted small" style="margin:6px 0 0">Everyone who can sign in, and what they can see.</p></div></div>
<div class="role-key">
  <% roles.forEach(r => { %><div><span class="pill role-<%= r.key %>"><%= r.label %></span> <span class="muted small"><%= r.hint %></span></div><% }) %>
</div>
<div class="grid2 wide-left" style="align-items:start">
  <div class="card flush">
    <table>
      <thead><tr><th>Name</th><th>Role</th><th>Status</th><th>Open jobs</th></tr></thead>
      <tbody>
      <% users.forEach(u => { %>
        <tr onclick="location='/admin/team/<%= u.id %>'" class="<%= u.active ? '' : 'inactive' %>">
          <td><strong><%= u.name || '—' %></strong><div class="muted small"><%= u.email %></div></td>
          <td><span class="pill role-<%= u.role %>"><%= roles.find(r => r.key === u.role).label %></span></td>
          <td class="small"><%= !u.active ? 'Switched off' : !u.has_password ? (u.invite_open ? 'Invite sent' : 'Needs a sign-in link') : u.last_login_at ? 'Last in ' + fmtDate(u.last_login_at) : 'Set up' %></td>
          <td><%= u.open_jobs || '—' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <form class="card form" method="post" action="/admin/team">
    <h2>Add someone</h2>
    <% if (error) { %><p class="alert"><%= error %></p><% } %>
    <label>Name <input name="name" required value="<%= form.name || '' %>"></label>
    <label>Email <small class="muted">— they sign in with this</small><input type="email" name="email" required value="<%= form.email || '' %>"></label>
    <label>Mobile <small class="muted">— optional</small><input type="tel" name="phone" value="<%= form.phone || '' %>"></label>
    <label>Role
      <select name="role" required><% roles.forEach(r => { %><option value="<%= r.key %>" <%= (form.role || 'crew') === r.key ? 'selected' : '' %>><%= r.label %></option><% }) %></select></label>
    <button class="btn gold full">Add &amp; get sign-in link</button>
    <p class="muted small" style="margin-bottom:0">You’ll get a one-time link to text or email them. They open it and choose their own password.</p>
  </form>
</div>
<%- include('../partials/foot') %>
