<%- include('../partials/head') %>
<div class="pagehead"><h1>Jobs</h1><a class="btn gold" href="/admin/jobs/new">+ New job</a></div>
<div class="card flush">
  <table>
    <thead><tr><th>Date</th><th>Client</th><th>Service / package</th><th>Crew</th><th>Status</th><th>Payment</th><th style="text-align:right">Quoted</th><th style="text-align:right">Profit</th></tr></thead>
    <tbody>
    <% if (!jobs.length) { %><tr><td colspan="8" class="muted center">No jobs yet. Create one from an accepted quote.</td></tr><% } %>
    <% jobs.forEach(j => { %>
      <tr onclick="location='/admin/jobs/<%= j.id %>'">
        <td class="small"><%= j.job_date ? fmtDate(j.job_date) : '—' %></td>
        <td><strong><%= j.client_name || '—' %></strong></td>
        <td><%= j.service || '' %><div class="muted small"><%= j.package || '' %></div></td>
        <td class="small"><%= j.employees || '—' %></td>
        <td><span class="pill <%= j.status %>"><%= j.status.replace('_',' ') %></span></td>
        <td><span class="pill <%= j.payment_status %>"><%= j.payment_status %></span></td>
        <td class="money" style="text-align:right"><%= j.quoted_price != null ? money(j.quoted_price) : '—' %></td>
        <td class="money <%= j.profit != null ? (j.profit < 0 ? 'neg' : 'pos') : '' %>" style="text-align:right"><%= j.profit != null ? money(j.profit) : '—' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/foot') %>
