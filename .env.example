# Copy this file to .env and fill in your values. .env is never committed.
PORT=3000
NODE_ENV=development

# Your PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/northline
# Set to true for hosted databases that require SSL (Render, Neon, Supabase…)
DATABASE_SSL=false

# Long random string used to sign login sessions
SESSION_SECRET=change-me-to-a-long-random-string

# First admin login — created automatically on startup if no admin exists yet
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Resend (https://resend.com) — leave blank to preview emails without sending
RESEND_API_KEY=
EMAIL_FROM=Northline Landscaping <hello@yourdomain.com>

BUSINESS_NAME=Northline Home & Outdoor
# Shown in the website header/footer (leave blank to hide)
BUSINESS_PHONE=
BUSINESS_EMAIL=
# Where new estimate-request alerts are emailed (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=
# Your live web address, used in quote links (e.g. https://yourdomain.com)
PUBLIC_URL=
